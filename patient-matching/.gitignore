# Python virtual environment (never commit this - it's big and machine-specific;
# anyone can rebuild it from requirements.txt)
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Common editor/OS clutter
.DS_Store
.vscode/

# Local scratch data - real EMS/hospital data is sensitive (PHI) and should
# never be committed. Files explicitly named "synthetic_*", "splink_*", or
# "evaluation_*" are fake data we generated ourselves, or derived
# outputs/model configs/evaluation results from it, and are safe/intended
# to commit -- EXCEPT the full 500x500 cross-join prediction file, which is
# ~56MB and fully reproducible by re-running src/probabilistic_matcher.py
# (or src/evaluate_matching.py, which regenerates it in-memory), so it
# isn't worth permanently bloating the repo with.
data/*
!data/.gitkeep
!data/synthetic_*.csv
!data/splink_*
!data/evaluation_*.csv
!data/threshold_*.csv
!data/resolved_rate_*.csv
!data/normalization_*.csv
data/splink_predictions_full_cross_join.csv
# Step 10's full 250,000-row cross-join predictions (raw and normalized
# variants) are the same ~54-56MB shape as the file above, for the same
# reason -- reproducible by re-running src/normalization_impact_analysis.py.
data/normalization_splink_predictions_raw.csv
data/normalization_splink_predictions_normalized.csv

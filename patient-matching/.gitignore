# Python virtual environment (never commit this - it's big and machine-specific;
# anyone can rebuild it from requirements.txt)
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Common editor/OS clutter
.DS_Store
.vscode/

# Local scratch data - real EMS/hospital data is sensitive (PHI) and should
# never be committed. Files explicitly named "synthetic_*" are fake data we
# generated ourselves with Faker and are safe/intended to commit.
data/*
!data/.gitkeep
!data/synthetic_*.csv
